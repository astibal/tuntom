#!/bin/sh
set -e

if ! getent group tuntom >/dev/null; then
    addgroup --system tuntom
fi

if ! getent passwd tuntom >/dev/null; then
    adduser --system --ingroup tuntom --no-create-home \
        --home /nonexistent --shell /usr/sbin/nologin tuntom
fi

if ! command -v systemd-tmpfiles >/dev/null 2>&1 ||
        ! systemd-tmpfiles --create tuntom.conf; then
    install -d -o tuntom -g tuntom -m 0750 /run/tuntom
fi

exit 0
