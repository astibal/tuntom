# Standalone protocol validation, not a replacement for the TUN/VPN daemon.
add_library(tuntom-core INTERFACE)
target_include_directories(tuntom-core INTERFACE "${PROJECT_SOURCE_DIR}/src")
if(WIN32)
    target_compile_definitions(tuntom-core INTERFACE NOMINMAX WIN32_LEAN_AND_MEAN)
    target_link_libraries(tuntom-core INTERFACE bcrypt)
endif()

include(CTest)
if(BUILD_TESTING)
    add_executable(portable_core_test tests/portable_core_test.cpp)
    target_link_libraries(portable_core_test PRIVATE tuntom-core)
    if(MSVC)
        target_compile_options(portable_core_test PRIVATE /W4 /permissive-)
    else()
        target_compile_options(portable_core_test PRIVATE -Wall -Wextra -Wpedantic)
    endif()
    if(MINGW)
        target_link_options(portable_core_test PRIVATE -static -static-libgcc -static-libstdc++)
    endif()
    add_test(NAME portable_core COMMAND portable_core_test)
    set_tests_properties(portable_core PROPERTIES TIMEOUT 30)
endif()
