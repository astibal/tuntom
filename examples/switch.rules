# New ruleset format. Increase serial before applying an edited configuration.
format 1
serial 2026091301

exit internet

switch client-42*,17 to internet,1001 allow
switch internet,1001 to client-42*,44 allow
# All other traffic is implicitly dropped.

label client-42*,17 to internet, [1001, ...]
label internet,1001 to client-42*, [44, ...]
